# Local Tesseract OCR plus deterministic rules is the privacy-preserving default.
# gemini sends document images to Google; hybrid runs both providers for comparison.
EXTRACTION_MODE=local_ocr_rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90
TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=heb+eng
# EXTRACTION_DATA_DIR=D:\MedicalExtractionData

# Configure both values to enable Supabase persistence.
# Keep the service-role key on the backend only; never add it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
